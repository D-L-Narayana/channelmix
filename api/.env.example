# Local: SQLite needs no server. Production: Supabase transaction pooler (:6543), sslmode=require.
DATABASE_URL=sqlite:///./channelmix.db
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
# null = NullPool (serverless / transaction pooler, auto when VERCEL is set); queue = normal pool for long-lived servers
DB_POOL=queue
# leave unset to use the in-memory LRU cache
# REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=2048
LOG_LEVEL=INFO
CORS_ORIGINS=https://channelmix.vercel.app,http://localhost:5173
SSE_MAX_SECONDS=25
SSE_HEARTBEAT_SECONDS=15
PUBLIC_WEB_URL=https://channelmix.vercel.app
