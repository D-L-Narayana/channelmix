{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "index.py": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index"
    }
  ],
  "headers": [
    {
      "source": "/api/v1/stream",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-transform" }
      ]
    }
  ],
  "regions": ["bom1"]
}
